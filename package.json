  "description": "awsy (AWS YAML) is a TypeScript CLI that compiles YAML-defined AWS infrastructure to CDK/CloudFormation deployments.",
  "main": "dist/cli.js",
  "scripts": {
    "test": "tsc -p tsconfig.test.json && vitest run",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "lint": "echo \"No lint configured\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "README.md"
