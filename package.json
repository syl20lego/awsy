  "bin": {
    "awsy": "dist/cli.js"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.245.0",
    "aws-cdk": "^2.1029.2",
    "commander": "^14.0.3",
    "constructs": "^10.6.0",
    "js-yaml": "^4.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
